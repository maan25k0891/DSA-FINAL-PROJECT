    static int lowerbound(Student** a, int n, double value, int& steps) {
        int lo = 0, hi = n;
        while (lo < hi) {
            int mid = lo + (hi - lo) / 2;
            steps++;
            if (a[mid]->getcgpa() < value) lo = mid + 1;
            else hi = mid;
        }
        return lo;
    }

    static int upperbound(Student** a, int n, double value, int& steps) {
        int lo = 0, hi = n;
        while (lo < hi) {
            int mid = lo + (hi - lo) / 2;
            steps++;
            if (a[mid]->getcgpa() <= value) lo = mid + 1;
            else hi = mid;
        }
        return lo;
    }

